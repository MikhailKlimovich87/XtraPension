<apex:page readOnly="true" id="WorkHistory" sidebar="false" renderAs="advanced_pdf" standardStylesheets="false" showHeader="false" applyHtmlTag="false" applyBodyTag="false">
    <html>
        <head>
            <style>
                @page {
                    size: 210mm 297mm;
					margin-top: 50px;
					margin-bottom: 20px;
					@bottom-left {
                        content: element(footer);
                    }
                }

                .title-block {
                    font-size:20pt;
                    text-align:center
                }

				div.footer {
            		position: running(footer);
                    width: 100%;
                    margin-right: 1px;
                    text-align: center;
					color:#808080;
					font-size:8pt;
					height:20%
				}

				body {
					font-family: "Roboto", sans-serif;
					/* font-size: 11px; */
				}

				table {
					border-collapse: collapse;
					width:100%;
				}

				td, th {
					border-width: 1px;
					border-style: solid;
				}

				th {
					text-align:center;
				}

                h3 {
					text-align: center;
                }

				.date-col {
					text-align: center;
				}
				.breakPageAfter{
      				page-break-after:always;
   				}
            </style>
        </head>
