<apex:page renderAs="advanced_pdf"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyBodyTag="false"
           applyHtmlTag="false"
           controller="BP_ClientSummaryPdfController"
           >
           <apex:stylesheet value="{!$Resource.BP_Yellow}"/>
<html style="margin: 0px; padding: 0px;">
    <head>
        <style>
            @page {
                size: A4;
                margin: 20px 20px 20px 60px;
            }
        </style>
        
    </head>
<body>
<table style="width:100%;
              height:100%;
              border-collapse:collapse;
              font-family:Arial, Helvetica, sans-serif;">


        <!-- CONTENT -->
        <tr>

            <td></td>

            <td style="vertical-align:top;
                    padding-left:20px;
                    padding-right:20px;">

                <!-- TITLE -->

                <div style="text-align:center;
                            font-size:24px;
                            
                            margin-top:20px;
                            margin-bottom:20px;">

                    Client:   <span style="font-weight:bold;text-transform: uppercase; color: #EF0000;">{!client.Claimant_title__c} {!client.First_Name__c} {!client.Last_Name__c} </span>

                </div>

                <div style="text-align:center;
                            font-size:24px;
                            
                            margin-top:20px;
                            margin-bottom:20px;">

                    XtraPension Claim Number:   <span style="font-weight:bold;color: #EF0000;">{!client.Name}</span>

                </div>

                <div style="text-align:center;
                            font-size:24px;
                            
                            margin-top:20px;
                            margin-bottom:20px;">

                    Deposit Paid:   <b><apex:outputText value="{0,number,0}" style="color: #EF0000;">
                                        <apex:param value="{!DAY(client.Deposit_Payment_Date__c)}" />
                                    </apex:outputText>

                    <!-- <sup>
                        <apex:outputText style="color: #EF0000;" value="{!IF(AND(DAY(client.Deposit_Payment_Date__c) >= 11, DAY(client.Deposit_Payment_Date__c) <= 13), 'th', 
                                                IF(MOD(DAY(client.Deposit_Payment_Date__c), 10) == 1, 'st', 
                                                IF(MOD(DAY(client.Deposit_Payment_Date__c), 10) == 2, 'nd', 
                                                IF(MOD(DAY(client.Deposit_Payment_Date__c), 10) == 3, 'rd', 'th'))))}" />
                    </sup> -->

                    <apex:outputText style="color: #EF0000;" value=" {0,date,MMMM yyyy}">
                        <apex:param value="{!client.Deposit_Payment_Date__c}" />
                    </apex:outputText>
                    </b>

                </div>

                <div style="text-align:center;
                            font-size:24px;
                            margin-top:20px;
                            margin-bottom:20px;">

                    Address:  
                    <apex:repeat value="{!addressLines}" var="line">
                        <span style="font-weight:bold;text-transform: uppercase; color: #EF0000;">{!line} </span> <br/>
                    </apex:repeat>

                </div>

                <div style="text-align:center;
                            font-size:24px;
                            margin-top:20px;
                            margin-bottom:50px;">

                    ==============

                </div>

                <!-- SECTION A -->

                <div style="font-size:18px;
                            font-weight:bold;
                            margin-bottom:45px; margin-left: 40px;">

                    Dear {!client.First_Name__c} {!client.Last_Name__c}

                </div>

                <div style="font-size:18px;
                            margin-bottom:45px; margin-left: 40px;">

                    Please post us back in the Stamp Addressed Envelope enclosed here…

                </div>

                <table style="width:100%;
                            border-collapse:collapse;
                            font-size:18px;
                            line-height:1.8; margin-left: 40px;">

                    <tr>
                        <td style="padding-bottom:16px;">
                            1. This
                            <span style="font-weight:bold;">YELLOW</span>
                            page
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-bottom:16px;">
                            2.
                            <span style="font-weight:bold;">
                                 DWP Letter of Authority - <u>  signed &amp; dated</u> 
                            </span>
                            by you with <sup>*</sup>BLACK<sup>*</sup> pen
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-bottom:16px;">
                            3. Two Pages stating
                            <span style="font-weight:bold;">
                                'DECLARATION'
                            </span>
                             - 
                            <span style="font-weight:bold;">
                                <u>  signed &amp; dated</u> 
                            </span>
                            by you
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-bottom:16px;">
                            4. Certified Colour
                            <span style="font-weight:bold;">
                                Photocopy of
                            </span>
                            Passport / Drivers License / Birth Cert
                        </td>
                    </tr>

                    <tr>
                        <td>
                            5. Certified Colour
                            <span style="font-weight:bold;">
                                Photocopy of
                            </span>
                            Marriage (/Death) Cert <i> if applicable</i>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <br/>
                            Thanks!
                        </td>
                    </tr>

                </table>

                <div style="height:20px;"></div>

                <!-- SECTION B -->
                <br/>
                <table style="width:100%;
                            border-collapse:collapse;
                            font-size:18px;
                            line-height:1.8; margin-left: 40px;">

                    <tr>
                        <td >
                            Client Support
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-bottom:16px;">
                            XtraPension Ltd
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <span style="font-weight:bold;">Irl Tel:</span> +353 (0)91 335 583
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <span style="font-weight:bold;">Aus/NZ:</span> +61 1300 339 559
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <span style="font-weight:bold;">Email:</span> clients@xtrapension.com
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <span style="font-weight:bold;">WhatsApp:</span> +353 (0)83 123 4000 (<i>NO calls please!</i> )
                        </td>
                    </tr>

                </table>
            </td>    
        </tr>

    </table>
</body>

</html>

</apex:page>