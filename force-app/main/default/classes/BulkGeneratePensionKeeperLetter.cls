public class BulkGeneratePensionKeeperLetter {
    public void generateZip() {
        Map<Id, Application__c> pkApps = new Map<Id, Application__c> ([
            SELECT Id, Pension_Keeper_Notification__c  FROM Application__c WHERE Pension_Keeper_Notification_Generated__c = null AND Pension_Keeper_Notification__c = true LIMIT 250
        ]);

        List<ContentDocumentLink> links = [
            SELECT Id, ContentDocument.Title, LinkedEntityId,ContentDocumentId FROM ContentDocumentLink 
             WHERE ContentDocument.Title LIKE '%Welcome_PK_Notification%' AND 
                    LinkedEntityId IN :pkApps.keySet()
        ];
        System.debug(links.size());
        Set<Id> ids = new Set<Id>();
        for(ContentDocumentLink link : links) {
            ids.add(link.ContentDocumentId);
        }
        List<ContentVersion> versions= [SELECT Id, Title, FileExtension, ContentDocumentId, VersionData, PathOnClient FROM ContentVersion WHERE ContentDocumentId IN :ids AND IsLatest = true];
        System.debug(versions.size());

        Compression.ZipWriter writer = new Compression.ZipWriter();

        for (ContentVersion file : versions) {
        // addEntry(fileName, fileBlob)
            writer.addEntry(file.PathOnClient, file.VersionData);
        }

        Blob zipBlob = writer.getArchive();

        // 5. (Optional) Save the new ZIP back to Salesforce
        ContentVersion cv = new ContentVersion();
        cv.Title = 'PensionKeeperLetter_1.zip';
        cv.PathOnClient = 'PensionKeeperLetter_1';
        cv.VersionData = zipBlob;
        insert cv;
        List<Application__c> updateApps = new List<Application__c>();
        for(Application__c app : pkApps.values()) {
            updateApps.add(new Application__c(Id = app.Id, Pension_Keeper_Notification_Generated__c = Date.today()));
        }
        update updateApps;
    }

