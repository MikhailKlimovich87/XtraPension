<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>PC1 Clients List</masterLabel>
    <description>Rich clients table for the Pension Credit home page: Name, Phone, Stage badge, Next Call, Progress bar, Created, Actions (View / Call Now / Fill on DWP).</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property name="pageSize" label="Page Size" type="Integer" default="100"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>